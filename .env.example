# Host user that owns ./workspace. Files written in the sandbox keep this
# ownership, so you can edit them without sudo on the host.
USER_UID=1000
USER_GID=1000

# Git identity used for commits created inside the sandbox.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# GitHub token for gh (issue reading/commenting, branches, pull requests).
# Classic token with the `repo` scope, or a fine-grained token with read/write
# on Contents, Issues and Pull requests (only if it can select the repository).
# Set an expiry (for example 90 days) and a reminder to rotate it before then.
# Create one at https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional: skip the interactive login. Use only one of them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
